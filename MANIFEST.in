include README.md LICENSE CITATION.cff THIRD_PARTY_NOTICES.md CHANGELOG.md CONTRIBUTING.md
include AUTHORS.md
include environment.yml
include .env.example
recursive-include .streamlit *.toml
recursive-include LICENSES *.txt
