# RIIO settings file. Copy this file to `.env` and fill in only what you need: every line is optional.
#
# Where RIIO looks for it (the first file found wins; `tfop setup` prints the one in use):
#   1. the file named by the PREDICTOR_ENV_FILE environment variable;
#   2. `.env` in the RIIO folder, when RIIO was installed from that folder (both installers do this);
#   3. the per-user settings file of a pip-installed RIIO:
#        Linux:   ~/.config/tf-operator-predictor/.env
#        Windows: %LOCALAPPDATA%\tfop\tf-operator-predictor\.env
# Real environment variables override this file. Values may be quoted; quoted paths may contain spaces.
# Never share or commit your `.env`: it can hold personal API keys.

# --- NCBI (recommended) ------------------------------------------------------------------------------
# A free NCBI API key raises NCBI's request rate limit (create one in your NCBI account settings).
# Requests still work without one, at the lower public rate. NCBI_API_KEY is accepted as an alias.
NCBI_TOKEN=
# The contact email NCBI asks API users to send with their requests.
NCBI_EMAIL=

# --- Optional folding (`tfop predict --fold`) ---------------------------------------------------------
# Token for the biohub ESMFold2 service. Used only when you ask for a fold.
BIOHUB_TOKEN=

# --- Engine locations ---------------------------------------------------------------------------------
# Needed only for a tool that is NOT on your PATH. env/install_linux.sh and env/install_windows.ps1 write
# these lines for you. To set one by hand, remove the leading "# " and use your real path.
#
# Linux:
# MMSEQS="/home/you/miniforge3/envs/riio-engines/bin/mmseqs"
# BLAST_BIN="/home/you/miniforge3/envs/riio-engines/bin"
# DATASETS_EXE="/home/you/miniforge3/envs/riio-engines/bin/datasets"
# BITACORA_DIR="/home/you/riio-v1/env/tools/bitacora"
# BITACORA_BIN="/home/you/miniforge3/envs/riio-engines/bin"
#
# Windows:
# MMSEQS="C:\Users\you\riio-v1\env\tools\mmseqs\bin\mmseqs.exe"
# BLAST_BIN="C:\Users\you\riio-v1\env\tools\ncbi-blast-2.17.0+\bin"
# DATASETS_EXE="C:\Users\you\riio-v1\env\tools\ncbi-datasets\datasets.exe"
#
# Windows, with BITACORA run inside WSL Ubuntu (docs/INSTALL_WINDOWS.md, genome discovery):
# BITACORA_DIR="C:\Users\you\riio-v1\env\tools\bitacora"
# BITACORA_WSL_DISTRO=Ubuntu
# BITACORA_BIN=/home/you/miniforge3/envs/riio-engines/bin
#
# Optional MetalNet2 metal-site evidence (docs/ENGINES.md):
# METALNET_PYTHON="/path/to/envs/metalnet/bin/python"
# METALNET2_DIR="/path/to/metalnet2"
