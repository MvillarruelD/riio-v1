# predictor API credentials -- copy to `.env` and fill in (or set as real environment variables).
# predictor.resources reads this file and load_tokens() puts the values in os.environ so BOTH the
# ESMFold2 folding backend and the NCBI client pick them up, wherever the .env lives.
# Override the location with PREDICTOR_ENV_FILE=/path/to/.env

# Optional: biohub ESMFold2 token. Used only when the user opts into `--fold` / "Apo fold".
BIOHUB_TOKEN=your-biohub-token-here

# Recommended: NCBI Entrez key for reliable genome/IPG/promoter fetches. NCBI_API_KEY is an alias.
# Requests can run without a key at NCBI's lower public rate limit.
NCBI_TOKEN=your-ncbi-key-here

# optional: the email NCBI Entrez asks for
NCBI_EMAIL=you@example.com

# Engine locations. Set these only when a tool lives outside PATH -- `tfop setup` and the code
# that runs the tool both read them, so they stay in agreement.
# NCBI Datasets CLI. Installed into its OWN conda env on purpose: it is a standalone Go binary, and
# keeping the solver away from the working `data` env avoids perturbing numpy/pandas under the pipeline.
# DATASETS_EXE=/absolute/path/to/datasets
# BITACORA (optional): WSL distro and the dir holding hmmsearch/blastp inside it.
# BITACORA_WSL_DISTRO=Ubuntu
# BITACORA_BIN=$HOME/miniforge3/envs/bitacora/bin
